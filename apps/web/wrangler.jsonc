{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Entry custom: reexporta o worker do OpenNext e acrescenta o `scheduled` do cron
  // (o `.open-next/worker.js` é regenerado a cada build e só exporta `fetch`).
  "main": "worker.ts",
  "name": "asafe",
  // Pin do comportamento do runtime (NÃO é a data do projeto): o workerd só liga mudanças
  // incompatíveis para Workers cuja data alcance a mudança. Ficou em 2024-12-30 (default do
  // template do OpenNext) desde o primeiro deploy. Alinhado ao eaifez, que roda esta data em
  // produção sobre o mesmo OpenNext 1.20 — evidência real, em vez de pegar a data de hoje só
  // por ser maior.
  "compatibility_date": "2026-06-01",
  // nodejs_compat: APIs de Node no workerd (o app usa @supabase/ssr com cookies).
  // global_fetch_strictly_public: fetch() vai à internet pública (recomendado p/ OpenNext).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Domínio de produção (a zona asafe.mus.br já está na Cloudflare). Deixa o custom domain
  // versionado: cada `deploy` reconcilia o apontamento em vez de arriscar removê-lo.
  "routes": [{ "pattern": "asafe.mus.br", "custom_domain": true }],
  // Mantém o *.workers.dev ATIVO (definir `routes` sozinho desliga — error 1042). Precisamos
  // dele vivo para os links antigos (WhatsApp) chegarem no Worker e serem 301 → asafe.mus.br.
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Keepalive do Supabase (worker.ts → scheduled): o free pausa o projeto após ~7 dias
  // sem atividade. Uma vez por dia dá margem folgada. 05:00 UTC = 02:00 BRT; a fila de
  // crons da Cloudflare pode atrasar alguns minutos, o que é irrelevante aqui.
  "triggers": {
    "crons": ["0 5 * * *"]
  },
  // Logs do cron no painel do Worker — sem isso o `throw` do keepalive falha em silêncio.
  "observability": {
    "enabled": true
  }
}
